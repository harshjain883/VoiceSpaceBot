# Telegram Bot Credentials
API_ID=12345678
API_HASH=abcdef0123456789abcdef0123456789
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
BOT_USERNAME=YourBotUsername

# Bot Owner ID (God Mode & Immunity)
OWNER_ID=123456789

# Public Web URL (Railway domain ya VPS domain bina trailing slash ke)
WEBAPP_URL=https://stringgen-production.up.railway.app

# MongoDB Connection
# VPS Docker setup ke liye: mongodb://mongo:27017
# Railway / Cloud setup ke liye: mongodb+srv://user:pass@cluster.mongodb.net
MONGO_URI=mongodb://mongo:27017
DB_NAME=voicespace_db

# LiveKit SFU Config
# VPS Docker ke liye: ws://YOUR_VPS_IP:7880 (ya local network ws://127.0.0.1:7880)
# LiveKit Cloud ke liye: wss://your-project.livekit.cloud
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
