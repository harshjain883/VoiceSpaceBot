# Telegram Bot Credentials
API_ID=12345678
API_HASH=your_api_hash_here
BOT_TOKEN=your_bot_token_here
BOT_USERNAME=YourBotUsername
OWNER_ID=123456789


# Public Web URL (Railway domain ya VPS domain)
WEBAPP_URL=https://your-domain.up.railway.app

# LiveKit SFU Credentials
# Option 1: LiveKit Cloud se milega (wss://your-project.livekit.cloud)
# Option 2: VPS self-hosted (ws://your-vps-ip:7880 ya wss://domain)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=devkey_or_cloud_key
LIVEKIT_API_SECRET=secret_or_cloud_secret
